# Notion Integration Settings
NOTION_API_KEY=ntn_your_notion_secret_or_integration_token_here
NOTION_DATABASE_ID=your_32_character_notion_database_id_here

# HeyPocket Webhook Settings
# (Optional but recommended: Set if you configure an HMAC secret in HeyPocket)
HEYPOCKET_WEBHOOK_SECRET=your_heypocket_signing_secret_here

# Server Port (for standalone / local dev)
PORT=3000
